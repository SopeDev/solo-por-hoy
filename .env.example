# Postgres connection string (Prisma Postgres via the Vercel integration also sets POSTGRES_URL).
DATABASE_URL=

# Auth.js secret (generate with `npx auth secret`) and Google OAuth client.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google account emails allowed to sign in.
ALLOWED_EMAILS=

# Web Push keys (generate with `npx web-push generate-vapid-keys`) and a contact for the push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron sends this as a bearer token; any long random string (e.g. `openssl rand -hex 32`).
CRON_SECRET=

# IANA time zone that decides what "today" is. Defaults to America/Tijuana.
APP_TIME_ZONE=
